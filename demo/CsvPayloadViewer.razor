@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="trader-card p-0 overflow-hidden">
    <!-- Header Toolbar -->
    <div class="px-4 py-3 d-flex justify-content-between align-items-center border-bottom" style="background-color: var(--bg-surface-elevated); border-color: var(--border-subtle) !important;">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold" style="font-size: 12px; color: var(--text-primary);">@Title</span>
            @if (!string.IsNullOrWhiteSpace(Format))
            {
                <span class="badge" style="background-color: var(--bg-surface); color: var(--teal-accent, #007A91); border: 1px solid var(--border-subtle); font-size: 10px;">
                    @Format
                </span>
            }
            @if (parsedRows.Count > 0 || parsedHeaders.Count > 0)
            {
                <span class="trader-badge" style="background-color: var(--uc-teal-soft, rgba(0, 122, 145, 0.20)); color: var(--teal-accent, #007A91); font-weight: 700; padding: 2px 8px; border-radius: 4px; font-size: 10px;">
                    @parsedRows.Count @(parsedRows.Count == 1 ? "Row" : "Rows") × @parsedHeaders.Count @(parsedHeaders.Count == 1 ? "Column" : "Columns")
                </span>
            }
            @if (!string.IsNullOrEmpty(CsvContent))
            {
                <span class="text-muted tabular-nums" style="font-size: 10px;">
                    (@CsvContent.Length.ToString("N0") chars)
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" 
                    class="btn-copy-payload shadow-sm"
                    disabled="@string.IsNullOrEmpty(CsvContent)"
                    @onclick="CopyPayload">
                @if (copiedPayload)
                {
                    <span class="d-inline-flex align-items-center gap-1" style="color: #28a745;">
                        <i class="ui-icon ui-icon-check"></i> Copied to Clipboard
                    </span>
                }
                else
                {
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="ui-icon ui-icon-copy"></i> Copy Payload
                    </span>
                }
            </button>
        </div>
    </div>

    <!-- Grid / Table View Body -->
    <div class="p-3" style="background-color: var(--bg-surface);">
        @if (string.IsNullOrWhiteSpace(CsvContent))
        {
            <div class="p-4 text-center text-muted" style="font-size: 12px;">
                No input payload available for this publication request.
            </div>
        }
        else if (parsedHeaders.Count == 0 && parsedRows.Count == 0)
        {
            <div class="p-4 text-center text-muted" style="font-size: 12px;">
                No tabular data could be extracted from payload.
            </div>
        }
        else
        {
            <div class="csv-grid-container">
                <table class="csv-grid-table">
                    <thead>
                        <tr>
                            <th class="csv-th-index" title="Row Index">#</th>
                            @foreach (var header in parsedHeaders)
                            {
                                <th class="csv-th-col" title="@header">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int rowIndex = 0; rowIndex < parsedRows.Count; rowIndex++)
                        {
                            var row = parsedRows[rowIndex];
                            <tr class="csv-grid-row">
                                <td class="csv-td-index">@(rowIndex + 1)</td>
                                @for (int colIndex = 0; colIndex < parsedHeaders.Count; colIndex++)
                                {
                                    var cellValue = colIndex < row.Count ? row[colIndex] : string.Empty;
                                    <td class="csv-td-cell" title="@cellValue">@cellValue</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? CsvContent { get; set; }

    [Parameter]
    public string Title { get; set; } = "Input Payload";

    [Parameter]
    public string? Format { get; set; }

    private List<string> parsedHeaders = new();
    private List<List<string>> parsedRows = new();
    private bool copiedPayload;
    private string? _previousContent;

    protected override void OnParametersSet()
    {
        if (CsvContent != _previousContent)
        {
            _previousContent = CsvContent;
            ParseCsv(CsvContent);
        }
    }

    private void ParseCsv(string? content)
    {
        parsedHeaders.Clear();
        parsedRows.Clear();

        if (string.IsNullOrWhiteSpace(content))
            return;

        var rows = ParseCsvToRows(content);
        if (rows.Count == 0)
            return;

        parsedHeaders = rows[0];
        if (rows.Count > 1)
        {
            for (int i = 1; i < rows.Count; i++)
            {
                parsedRows.Add(rows[i]);
            }
        }
    }

    private static List<List<string>> ParseCsvToRows(string text)
    {
        var result = new List<List<string>>();
        if (string.IsNullOrWhiteSpace(text))
            return result;

        // Auto-detect delimiter from the first line (comma, semicolon, or tab)
        var firstLineEnd = text.IndexOfAny(new[] { '\r', '\n' });
        var firstLine = firstLineEnd >= 0 ? text[..firstLineEnd] : text;
        char delimiter = ',';
        if (!firstLine.Contains(',') && firstLine.Contains(';'))
            delimiter = ';';
        else if (!firstLine.Contains(',') && firstLine.Contains('\t'))
            delimiter = '\t';

        var currentRow = new List<string>();
        var currentField = new System.Text.StringBuilder();
        bool inQuotes = false;

        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];

            if (inQuotes)
            {
                if (c == '"')
                {
                    if (i + 1 < text.Length && text[i + 1] == '"')
                    {
                        currentField.Append('"');
                        i++; // skip next quote
                    }
                    else
                    {
                        inQuotes = false;
                    }
                }
                else
                {
                    currentField.Append(c);
                }
            }
            else
            {
                if (c == '"')
                {
                    inQuotes = true;
                }
                else if (c == delimiter)
                {
                    currentRow.Add(currentField.ToString().Trim());
                    currentField.Clear();
                }
                else if (c == '\r')
                {
                    if (i + 1 < text.Length && text[i + 1] == '\n')
                    {
                        i++;
                    }
                    currentRow.Add(currentField.ToString().Trim());
                    currentField.Clear();
                    if (currentRow.Any(cell => !string.IsNullOrEmpty(cell)))
                        result.Add(currentRow);
                    currentRow = new List<string>();
                }
                else if (c == '\n')
                {
                    currentRow.Add(currentField.ToString().Trim());
                    currentField.Clear();
                    if (currentRow.Any(cell => !string.IsNullOrEmpty(cell)))
                        result.Add(currentRow);
                    currentRow = new List<string>();
                }
                else
                {
                    currentField.Append(c);
                }
            }
        }

        // Add last field and row if any
        if (currentField.Length > 0 || currentRow.Count > 0)
        {
            currentRow.Add(currentField.ToString().Trim());
            if (currentRow.Any(cell => !string.IsNullOrEmpty(cell)))
                result.Add(currentRow);
        }

        return result;
    }

    private async Task CopyPayload()
    {
        if (!string.IsNullOrEmpty(CsvContent))
        {
            await JSRuntime.InvokeVoidAsync("copyToClipboard", CsvContent);
            copiedPayload = true;
            StateHasChanged();
            await Task.Delay(2000);
            copiedPayload = false;
            StateHasChanged();
        }
    }
}
